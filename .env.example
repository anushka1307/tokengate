# Copy to .env for local runs. Never commit .env.
# Every setting is read from environment variables (12-factor). Variables are added here as
# components land; each one is documented in app/config.py.

TOKENGATE_ENV=local          # local | test | prod  (prod hides /docs and /openapi.json)
TOKENGATE_LOG_LEVEL=INFO

# Shared outbound HTTP client (timeouts in seconds; all must be > 0)
TOKENGATE_HTTP_CONNECT_TIMEOUT_S=2.0
TOKENGATE_HTTP_READ_TIMEOUT_S=30.0
TOKENGATE_HTTP_WRITE_TIMEOUT_S=5.0
TOKENGATE_HTTP_POOL_TIMEOUT_S=2.0
TOKENGATE_HTTP_MAX_CONNECTIONS=100
TOKENGATE_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Model aliases clients may request -> "provider/model" (JSON). Only these aliases are accepted.
TOKENGATE_MODEL_ROUTES={"mock-1": "mock/echo-v1"}

# MockProvider: latency (ms) and failure rates (0-1), for load and chaos tests.
TOKENGATE_MOCK_FIRST_TOKEN_DELAY_MS=0
TOKENGATE_MOCK_PER_TOKEN_DELAY_MS=0
TOKENGATE_MOCK_ERROR_RATE=0
TOKENGATE_MOCK_MID_STREAM_ERROR_RATE=0
# TOKENGATE_MOCK_SEED=42

# Request limits
TOKENGATE_MAX_BODY_BYTES=1048576
TOKENGATE_MAX_MESSAGES=256
TOKENGATE_MAX_INPUT_CHARS=200000
TOKENGATE_MAX_COMPLETION_TOKENS=4096

# /metrics bearer token (>= 16 chars). Unset: open locally, disabled (404) in prod.
# TOKENGATE_METRICS_TOKEN=
# Graceful shutdown limit in seconds; keep below 10 on Cloud Run.
TOKENGATE_GRACEFUL_SHUTDOWN_TIMEOUT_S=8

# Postgres (tenants and API keys). Optional until step 2.2; local example:
# TOKENGATE_DATABASE_URL=postgresql://localhost/tokengate_dev
TOKENGATE_DB_POOL_MIN_SIZE=0
TOKENGATE_DB_POOL_MAX_SIZE=5
TOKENGATE_DB_CONNECT_TIMEOUT_S=3
TOKENGATE_DB_QUERY_TIMEOUT_S=2
